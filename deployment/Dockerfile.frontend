FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY . .
RUN dotnet publish src/SonOfAnton.Frontend -c Release -o /out -p:WasmBuildNative=false
FROM nginxinc/nginx-unprivileged:1.28-alpine
USER root
RUN apk add --no-cache jq
COPY --from=build /out/wwwroot /usr/share/nginx/html
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf
COPY deployment/frontend-entrypoint.sh /opt/frontend-entrypoint.sh
RUN chmod 755 /opt/frontend-entrypoint.sh && chown -R 101:101 /usr/share/nginx/html
USER 101
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/opt/frontend-entrypoint.sh"]
