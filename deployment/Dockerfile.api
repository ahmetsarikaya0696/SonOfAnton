FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY . .
RUN dotnet publish src/SonOfAnton.Backend -c Release -o /out
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out .
ENV ASPNETCORE_HTTP_PORTS=8080 PORT=8080 ASPNETCORE_ENVIRONMENT=Production Execution__WorkerEnabled=false Hosting__PlatformTls=true
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "SonOfAnton.Backend.dll"]
