@page "/credentials"
@using SonOfAnton.Frontend.Components
@using SonOfAnton.Shared.DTOs
@inject CredentialService CredentialService
@inject IJSRuntime JS

<div class="credentials-page apikeys-page">
    <header class="page-header">
        <div class="header-title">
            <h2><Icon Name="lock" Size="24" /> Credential Vault</h2>
            <p>Güvenli kasa, uygulamanız için gereken şifre, token ve gizli anahtarları kriptolu şekilde saklar.</p>
        </div>
        <div class="header-actions">
            <button class="btn btn-primary" @onclick="OpenCreateDialog">
                <Icon Name="plus" Size="14" /> Yeni Secret Ekle
            </button>
            <a href="/" class="btn btn-secondary">
                <Icon Name="arrow-left" Size="14" /> Editöre Dön
            </a>
        </div>
    </header>

    @if (_isLoading)
    {
        <div class="loading-state">
            <span class="spinner"></span>
            <span>Kimlik bilgileri yükleniyor...</span>
        </div>
    }
    else if (_credentials.Count == 0)
    {
        <div class="empty-state">
            <Icon Name="lock" Size="48" />
            <p>Henüz kasada bir secret bulunmuyor.</p>
            <button class="btn btn-primary mt-3" @onclick="OpenCreateDialog">İlk Secret'i Ekle</button>
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>İsim</th>
                        <th>Sistem Adı</th>
                        <th>Açıklama</th>
                        <th>Oluşturulma</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cred in _credentials)
                    {
                        <tr>
                            <td><strong>@cred.Name</strong></td>
                            <td class="font-mono text-muted">@cred.SystemName</td>
                            <td>@cred.Description</td>
                            <td>@cred.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="actions-cell">
                                <button class="btn btn-icon btn-danger" title="Sil" @onclick="() => DeleteAsync(cred)">
                                    <Icon Name="trash-2" Size="16" />
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_isDialogOpen)
{
    <div class="modal-backdrop">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Secret Ekle</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog">
                        <Icon Name="x" Size="20" />
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label>Başlık/İsim</label>
                        <input type="text" class="form-control" @bind="_newReq.Name" placeholder="Örn: Prod Veritabanı Şifresi" />
                    </div>
                    <div class="form-group mb-3">
                        <label>Sistem (Provider) Adı</label>
                        <input type="text" class="form-control" @bind="_newReq.SystemName" placeholder="Örn: postgres" />
                    </div>
                    <div class="form-group mb-3">
                        <label>Açıklama</label>
                        <input type="text" class="form-control" @bind="_newReq.Description" />
                    </div>
                    <div class="form-group mb-3">
                        <label>Gizli Veri (JSON Formatta olması önerilir)</label>
                        <textarea class="form-control" @bind="_newReq.RawData" rows="4" placeholder="{&#34;password&#34;: &#34;gizli...&#34;}"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDialog">İptal</button>
                    <button class="btn btn-primary" @onclick="SaveAsync">Kaydet</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CredentialDto> _credentials = new();
    private bool _isLoading = true;
    private bool _isDialogOpen = false;
    private CreateCredentialRequest _newReq = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _credentials = await CredentialService.GetCredentialsAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateDialog()
    {
        _newReq = new CreateCredentialRequest();
        _isDialogOpen = true;
    }

    private void CloseDialog()
    {
        _isDialogOpen = false;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_newReq.Name) || string.IsNullOrWhiteSpace(_newReq.RawData))
        {
            await JS.InvokeVoidAsync("alert", "Lütfen isim ve veri alanlarını doldurun.");
            return;
        }

        await CredentialService.CreateCredentialAsync(_newReq);
        _isDialogOpen = false;
        await LoadAsync();
    }

    private async Task DeleteAsync(CredentialDto cred)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"'{cred.Name}' isimli secret'ı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.");
        if (confirmed)
        {
            await CredentialService.DeleteCredentialAsync(cred.Id);
            _credentials.Remove(cred);
        }
    }
}
