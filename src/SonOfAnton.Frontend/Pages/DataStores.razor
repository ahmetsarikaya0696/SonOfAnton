@page "/datastores"
@inject WorkflowApiService ApiService

<div class="datastores-page">
    <header class="page-header">
        <h2><Icon Name="hard-drive" Size="20" /> Veri Depoları</h2>
        <a href="/" class="back-link">
            <Icon Name="arrow-left" Size="14" /> Editöre Dön
        </a>
    </header>

    <div class="page-content">
        <!-- Sol: Store Listesi -->
        <div class="store-list-panel">
            <div class="panel-header">
                <h3>Depolar</h3>
                <button class="btn btn-primary btn-sm" @onclick="() => _isCreateOpen = true">
                    <Icon Name="plus" Size="14" /> Yeni Depo
                </button>
            </div>

            @if (_isCreateOpen)
            {
                <div class="create-form">
                    <input type="text" @bind="_newStoreName" placeholder="Depo adı..." class="input" />
                    <input type="text" @bind="_newStoreDesc" placeholder="Açıklama (opsiyonel)" class="input" />
                    <div class="create-actions">
                        <button class="btn btn-success btn-sm" @onclick="CreateStore" disabled="@string.IsNullOrWhiteSpace(_newStoreName)">Oluştur</button>
                        <button class="btn btn-ghost btn-sm" @onclick="() => _isCreateOpen = false">İptal</button>
                    </div>
                </div>
            }

            @if (_isLoading)
            {
                <div class="loading-state">
                    <span class="spinner"></span>
                    <span>Yükleniyor...</span>
                </div>
            }
            else if (_stores.Count == 0)
            {
                <div class="empty-state">
                    <Icon Name="hard-drive" Size="48" />
                    <p>Henüz Data Store yok. Yeni bir depo oluşturun!</p>
                </div>
            }
            else
            {
                <div class="store-list">
                    @foreach (var store in _stores)
                    {
                        <div class="store-item @(store.Id == _selectedStoreId ? "active" : "")" @onclick="() => SelectStore(store.Id)">
                            <div class="store-info">
                                <span class="store-name">
                                    <Icon Name="database" Size="14" /> @store.Name
                                </span>
                                <span class="store-meta">@store.EntryCount kayıt · @store.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            <button class="btn-icon btn-danger-icon" @onclick:stopPropagation="true" @onclick="() => DeleteStore(store.Id)" title="Sil">
                                <Icon Name="trash-2" Size="14" />
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Sağ: Entry'ler (seçili store) -->
        <div class="entry-detail-panel">
            @if (_selectedStoreId == null)
            {
                <div class="empty-state">
                    <Icon Name="arrow-left-circle" Size="48" />
                    <p>Soldaki listeden bir depo seçin</p>
                </div>
            }
            else
            {
                <div class="panel-header">
                    <h3>Kayıtlar — @(_selectedStoreName)</h3>
                    <button class="btn btn-primary btn-sm" @onclick="() => _isAddEntryOpen = true">
                        <Icon Name="plus" Size="14" /> Yeni Kayıt
                    </button>
                </div>

                @if (_isAddEntryOpen)
                {
                    <div class="create-form">
                        <input type="text" @bind="_newEntryKey" placeholder="Anahtar (key)..." class="input" />
                        <textarea @bind="_newEntryValue" placeholder='Değer (JSON)&#10;Örn: {"count": 42}' class="input input-textarea" rows="3"></textarea>
                        <div class="create-actions">
                            <button class="btn btn-success btn-sm" @onclick="AddEntry" disabled="@string.IsNullOrWhiteSpace(_newEntryKey)">Kaydet</button>
                            <button class="btn btn-ghost btn-sm" @onclick="() => _isAddEntryOpen = false">İptal</button>
                        </div>
                    </div>
                }

                @if (_isLoadingEntries)
                {
                    <div class="loading-state">
                        <span class="spinner"></span>
                        <span>Kayıtlar yükleniyor...</span>
                    </div>
                }
                else if (_entries.Count == 0)
                {
                    <div class="empty-state small">
                        <Icon Name="inbox" Size="32" />
                        <p>Bu depoda henüz kayıt yok.</p>
                    </div>
                }
                else
                {
                    <div class="entry-table">
                        <div class="entry-header">
                            <span class="col-key">Anahtar</span>
                            <span class="col-value">Değer</span>
                            <span class="col-date">Güncelleme</span>
                            <span class="col-actions"></span>
                        </div>
                        @foreach (var entry in _entries)
                        {
                            <div class="entry-row">
                                <span class="col-key entry-key">@entry.Key</span>
                                <span class="col-value entry-value">
                                    <code>@FormatValue(entry.Value)</code>
                                </span>
                                <span class="col-date entry-date">@entry.UpdatedAt.ToString("dd.MM HH:mm")</span>
                                <span class="col-actions">
                                    <button class="btn-icon btn-danger-icon" @onclick="() => DeleteEntry(entry.Key)" title="Sil">
                                        <Icon Name="trash-2" Size="12" />
                                    </button>
                                </span>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<DataStoreDto> _stores = [];
    private List<DataStoreEntryDto> _entries = [];
    private bool _isLoading = true;
    private bool _isLoadingEntries;
    private bool _isCreateOpen;
    private bool _isAddEntryOpen;
    private Guid? _selectedStoreId;
    private string? _selectedStoreName;

    // Create store form
    private string _newStoreName = "";
    private string _newStoreDesc = "";

    // Add entry form
    private string _newEntryKey = "";
    private string _newEntryValue = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadStores();
    }

    private async Task LoadStores()
    {
        _isLoading = true;
        try
        {
            _stores = await ApiService.GetDataStoresAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Store listesi hatası: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateStore()
    {
        if (string.IsNullOrWhiteSpace(_newStoreName)) return;

        try
        {
            await ApiService.CreateDataStoreAsync(new CreateDataStoreRequest
            {
                Name = _newStoreName,
                Description = string.IsNullOrWhiteSpace(_newStoreDesc) ? null : _newStoreDesc
            });
            _newStoreName = "";
            _newStoreDesc = "";
            _isCreateOpen = false;
            await LoadStores();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Store oluşturma hatası: {ex.Message}");
        }
    }

    private async Task DeleteStore(Guid storeId)
    {
        try
        {
            await ApiService.DeleteDataStoreAsync(storeId);
            if (_selectedStoreId == storeId)
            {
                _selectedStoreId = null;
                _entries.Clear();
            }
            await LoadStores();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Store silme hatası: {ex.Message}");
        }
    }

    private async Task SelectStore(Guid storeId)
    {
        _selectedStoreId = storeId;
        _selectedStoreName = _stores.FirstOrDefault(s => s.Id == storeId)?.Name;
        _isAddEntryOpen = false;
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        if (_selectedStoreId == null) return;

        _isLoadingEntries = true;
        try
        {
            _entries = await ApiService.GetDataStoreEntriesAsync(_selectedStoreId.Value);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Entry listesi hatası: {ex.Message}");
        }
        finally
        {
            _isLoadingEntries = false;
        }
    }

    private async Task AddEntry()
    {
        if (_selectedStoreId == null || string.IsNullOrWhiteSpace(_newEntryKey)) return;

        try
        {
            object? parsedValue = null;
            if (!string.IsNullOrWhiteSpace(_newEntryValue))
            {
                try
                {
                    parsedValue = System.Text.Json.JsonSerializer.Deserialize<object>(_newEntryValue);
                }
                catch
                {
                    // String olarak kaydet
                    parsedValue = _newEntryValue;
                }
            }

            await ApiService.SetDataStoreEntryAsync(_selectedStoreId.Value, new SetDataStoreEntryRequest
            {
                Key = _newEntryKey,
                Value = parsedValue
            });
            _newEntryKey = "";
            _newEntryValue = "";
            _isAddEntryOpen = false;
            await LoadEntries();
            await LoadStores(); // entry count güncelle
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Entry ekleme hatası: {ex.Message}");
        }
    }

    private async Task DeleteEntry(string key)
    {
        if (_selectedStoreId == null) return;

        try
        {
            await ApiService.DeleteDataStoreEntryAsync(_selectedStoreId.Value, key);
            await LoadEntries();
            await LoadStores(); // entry count güncelle
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Entry silme hatası: {ex.Message}");
        }
    }

    private static string FormatValue(object? value)
    {
        if (value == null) return "null";
        var str = value.ToString() ?? "null";
        return str.Length > 120 ? str[..120] + "..." : str;
    }
}

<style>
    .datastores-page {
        height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--bg-primary);
        color: var(--text-primary);
        overflow: hidden;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        background: var(--bg-secondary);
    }

    .page-header h2 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-size: 1.25rem;
    }

    .back-link {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.85rem;
        transition: color 0.2s;
    }

    .back-link:hover {
        color: var(--accent-color);
    }

    .page-content {
        flex: 1;
        display: flex;
        overflow: hidden;
    }

    /* Store list panel */
    .store-list-panel {
        width: 340px;
        min-width: 280px;
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .panel-header h3 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .store-list {
        flex: 1;
        overflow-y: auto;
    }

    .store-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-subtle, rgba(255,255,255,0.05));
        cursor: pointer;
        transition: background 0.15s;
    }

    .store-item:hover {
        background: var(--bg-hover, rgba(255,255,255,0.05));
    }

    .store-item.active {
        background: var(--bg-active, rgba(137, 180, 250, 0.1));
        border-left: 3px solid var(--accent-color);
    }

    .store-info {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .store-name {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 600;
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .store-meta {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    /* Entry detail panel */
    .entry-detail-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .entry-table {
        flex: 1;
        overflow-y: auto;
    }

    .entry-header, .entry-row {
        display: grid;
        grid-template-columns: 180px 1fr 100px 40px;
        gap: 0.5rem;
        align-items: center;
        padding: 0.5rem 1rem;
    }

    .entry-header {
        font-weight: 600;
        font-size: 0.8rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid var(--border-color);
        background: var(--bg-secondary);
        position: sticky;
        top: 0;
    }

    .entry-row {
        border-bottom: 1px solid var(--border-subtle, rgba(255,255,255,0.04));
        font-size: 0.85rem;
    }

    .entry-row:hover {
        background: var(--bg-hover, rgba(255,255,255,0.03));
    }

    .entry-key {
        font-weight: 600;
        color: var(--accent-color);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .entry-value code {
        background: var(--bg-code, rgba(0,0,0,0.2));
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.8rem;
        color: var(--text-secondary, #cdd6f4);
        word-break: break-all;
    }

    .entry-date {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    /* Form styles */
    .create-form {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-color);
        background: var(--bg-secondary);
    }

    .input {
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
        color: var(--text-primary);
        font-size: 0.85rem;
        outline: none;
        transition: border-color 0.2s;
    }

    .input:focus {
        border-color: var(--accent-color);
    }

    .input-textarea {
        resize: vertical;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
    }

    .create-actions {
        display: flex;
        gap: 0.5rem;
    }

    /* States */
    .loading-state, .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        color: var(--text-muted);
        gap: 0.75rem;
    }

    .empty-state.small {
        padding: 1.5rem;
    }

    .spinner {
        width: 24px;
        height: 24px;
        border: 3px solid var(--border-color);
        border-top-color: var(--accent-color);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.45rem 0.85rem;
        border: none;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s;
    }

    .btn-sm {
        padding: 0.35rem 0.65rem;
        font-size: 0.8rem;
    }

    .btn-primary {
        background: var(--accent-color);
        color: var(--bg-primary);
    }

    .btn-primary:hover {
        opacity: 0.9;
    }

    .btn-success {
        background: var(--success-color, #a6e3a1);
        color: var(--bg-primary);
    }

    .btn-ghost {
        background: transparent;
        color: var(--text-muted);
    }

    .btn-ghost:hover {
        color: var(--text-primary);
        background: var(--bg-hover, rgba(255,255,255,0.05));
    }

    .btn-icon {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0.25rem;
        border-radius: 4px;
        color: var(--text-muted);
        transition: all 0.15s;
    }

    .btn-danger-icon:hover {
        color: var(--error-color, #f38ba8);
        background: rgba(243, 139, 168, 0.1);
    }
</style>
