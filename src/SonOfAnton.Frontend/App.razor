@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @if (!CorePages.Contains(routeData.PageType))
            {
                <LayoutView Layout="@typeof(MainLayout)"><div style="padding:3rem"><h1>Bu özellik henüz kullanıma açık değil</h1><a href="/">Workflow editörüne dön</a></div></LayoutView>
            }
            else
            {
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <p style="padding:2rem;color:#ef4444;">Bu sayfaya erişim yetkiniz yok.</p>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div style="display:flex;justify-content:center;align-items:center;height:100vh;color:rgba(255,255,255,0.6);">
                        Yetkilendiriliyor...
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            }
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {
    private static readonly HashSet<Type> CorePages = [typeof(Pages.Home), typeof(Pages.Dashboard), typeof(Pages.Executions), typeof(Pages.ExecutionDetail), typeof(Pages.Workspaces), typeof(Pages.WorkspaceDetail), typeof(Pages.ApiKeys), typeof(Pages.Authentication), typeof(Pages.NotFound)];
}
