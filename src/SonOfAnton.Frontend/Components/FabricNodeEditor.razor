@using SonOfAnton.Frontend.Services
@using SonOfAnton.Shared.Core.GraphEngine
@implements IAsyncDisposable
@inject NodeEditorInteropService EditorInterop
@inject IJSRuntime JSRuntime

<div class="fabric-node-editor" tabindex="0" @onkeydown="HandleKeyDown">
    <div class="editor-toolbar">
        <button class="btn btn-icon" @onclick="FitToScreen" title="Ekrana Sığdır">
            <Icon Name="maximize" Size="16" />
        </button>
        <button class="btn btn-icon" @onclick="ZoomIn" title="Yakınlaştır">
            <Icon Name="zoom-in" Size="16" />
        </button>
        <button class="btn btn-icon" @onclick="ZoomOut" title="Uzaklaştır">
            <Icon Name="zoom-out" Size="16" />
        </button>
        <span class="zoom-level">@($"{_zoomLevel:P0}")</span>
        
        <div class="spacer"></div>
        
        <button class="btn btn-icon" @onclick="AddNote" title="Not Ekle">
            <Icon Name="sticky-note" Size="16" />
        </button>
        <button class="btn btn-icon" @onclick="AddGroup" title="Grup Ekle">
            <Icon Name="box-select" Size="16" />
        </button>

        <div class="spacer"></div>

        <button class="btn btn-primary" @onclick="OnRunClicked" disabled="@IsExecuting">
            <Icon Name="play" Size="14" />
            Çalıştır
        </button>
        <button class="btn btn-danger" @onclick="OnStopClicked" disabled="@(!IsExecuting)">
            <Icon Name="square" Size="14" />
            Durdur
        </button>
    </div>
    
    <div class="canvas-container" @ref="_canvasContainer">
        <canvas id="@CanvasId"></canvas>
        <div class="minimap-container">
            <canvas id="@($"{CanvasId}-minimap")"></canvas>
        </div>

        @if (_contextMenu.Visible)
        {
            <div class="context-menu" style="left: @(_contextMenu.X)px; top: @(_contextMenu.Y)px;">
                <button class="context-item" @onclick="() => RenameSelectedNode()">
                    <Icon Name="edit-2" Size="14" /> Yeniden Adlandır
                </button>
                <button class="context-item" @onclick="() => ToggleBypassSelectedNode()">
                    <Icon Name="skip-forward" Size="14" /> Bypass
                </button>
                <hr class="context-divider" />
                <button class="context-item" @onclick="() => DuplicateSelectedNode()">
                    <Icon Name="copy" Size="14" /> Çoğalt
                </button>
                <button class="context-item" @onclick="() => DeleteSelectedNode()">
                    <Icon Name="trash-2" Size="14" /> Sil
                </button>
                <hr class="context-divider" />
                <button class="context-item" @onclick="() => DisconnectSelectedNode()">
                    <Icon Name="scissors" Size="14" /> Bağlantıları Kes
                </button>
            </div>
        }
        
        @if (_renameDialogOpen)
        {
            <div class="rename-dialog-overlay" @onclick="CancelRename">
                <div class="rename-dialog" @onclick:stopPropagation="true">
                    <h4>Yeniden Adlandır</h4>
                    <input @bind="_renameInput" @bind:event="oninput" @onkeyup="HandleRenameKey" placeholder="Yeni İsim" autofocus />
                    <div class="rename-actions">
                        <button class="btn btn-secondary" @onclick="CancelRename">İptal</button>
                        <button class="btn btn-primary" @onclick="ConfirmRename">Kaydet</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string CanvasId { get; set; } = "node-canvas";
    [Parameter] public EventCallback OnRun { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }
    [Parameter] public EventCallback<string> OnNodeSelected { get; set; }
    [Parameter] public EventCallback OnSelectionCleared { get; set; }
    [Parameter] public EventCallback<List<string>> OnSelectionChanged { get; set; }
    [Parameter] public EventCallback<(string FromNode, string FromPort, string ToNode, string ToPort)> OnConnectionCreated { get; set; }
    [Parameter] public EventCallback<string> OnNodeDeleted { get; set; }
    [Parameter] public EventCallback<string> OnNodeRenamed { get; set; }
    [Parameter] public EventCallback<(string NodeId, bool IsBypassed)> OnNodeBypassToggled { get; set; }
    
    [Parameter] public bool IsExecuting { get; set; }
    [Parameter] public bool EnableGridSnapping { get; set; }
    
    private ElementReference _canvasContainer;
    private double _zoomLevel = 1.0;
    private bool _initialized = false;
    private string? _contextMenuNodeId;
    private (bool Visible, double X, double Y) _contextMenu;
    private bool _renameDialogOpen;
    private string _renameInput = string.Empty;
    private List<string> _selectedNodeIds = new();
    
    protected override void OnInitialized()
    {
        EditorInterop.OnNodeSelected += HandleNodeSelected;
        EditorInterop.OnSelectionChanged += HandleSelectionChanged;
        EditorInterop.OnSelectionCleared += HandleSelectionCleared;
        EditorInterop.OnNodeMoved += HandleNodeMoved;
        EditorInterop.OnCanvasZoom += HandleZoom;
        EditorInterop.OnConnectionCreated += HandleConnectionCreated;
        EditorInterop.OnContextMenu += HandleContextMenu;
    }

    public async ValueTask DisposeAsync()
    {   
        if (_initialized)
        {
            EditorInterop.OnNodeSelected -= HandleNodeSelected;
            EditorInterop.OnSelectionChanged -= HandleSelectionChanged;
            EditorInterop.OnSelectionCleared -= HandleSelectionCleared;
            EditorInterop.OnNodeMoved -= HandleNodeMoved;
            EditorInterop.OnCanvasZoom -= HandleZoom;
            EditorInterop.OnConnectionCreated -= HandleConnectionCreated;
            EditorInterop.OnContextMenu -= HandleContextMenu;
            await EditorInterop.DisposeCanvasAsync(CanvasId);
        }
        
        await EditorInterop.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = await EditorInterop.InitializeCanvasAsync(CanvasId);
            
            if (_initialized)
            {
                if (EnableGridSnapping)
                {
                    await EditorInterop.SetGridSnappingAsync(true);
                }
            }
        }
    }
    
    /// <summary>
    /// Canvas'a node ekler
    /// </summary>
    public async Task AddNodeAsync(
        Guid nodeId,
        string nodeType,
        string nodeName,
        double x,
        double y,
        string color,
        List<PinInfo> inputs,
        List<PinInfo> outputs)
    {
        if (!_initialized) return;
        
        var config = new NodeConfig
        {
            Color = color,
            Inputs = inputs,
            Outputs = outputs
        };
        
        await EditorInterop.AddNodeAsync(
            nodeId.ToString(),
            nodeType,
            nodeName,
            x, y,
            config);
    }
    
    /// <summary>
    /// İki node arasına bağlantı ekler
    /// </summary>
    public async Task ConnectNodesAsync(
        Guid connectionId,
        Guid sourceNodeId,
        Guid targetNodeId,
        string sourcePort = "output",
        string targetPort = "input")
    {
        if (!_initialized) return;
        
        await EditorInterop.ConnectNodesAsync(
            connectionId.ToString(),
            sourceNodeId.ToString(),
            targetNodeId.ToString(),
            sourcePort,
            targetPort);
    }
    
    /// <summary>
    /// Node'u kaldırır
    /// </summary>
    public async Task RemoveNodeAsync(Guid nodeId)
    {
        if (!_initialized) return;
        await EditorInterop.RemoveNodeAsync(nodeId.ToString());
    }
    
    /// <summary>
    /// Node'un çalışma durumunu günceller
    /// </summary>
    public async Task SetNodeExecutingAsync(Guid nodeId, bool isExecuting)
    {
        if (!_initialized) return;
        await EditorInterop.SetExecutingStateAsync(nodeId.ToString(), isExecuting);
    }
    
    /// <summary>
    /// Node'u hata durumuna geçirir
    /// </summary>
    public async Task SetNodeErrorAsync(Guid nodeId, bool hasError)
    {
        if (!_initialized) return;
        await EditorInterop.SetErrorStateAsync(nodeId.ToString(), hasError);
    }
    
    /// <summary>
    /// Canvas'ı temizler
    /// </summary>
    public async Task ClearAsync()
    {
        if (!_initialized) return;
        await EditorInterop.ClearCanvasAsync();
    }

    private async Task AddNote()
    {
        await EditorInterop.AddNoteAsync(Guid.NewGuid().ToString(), "Yeni Not", 100, 100, "#f9e2af");
    }

    private async Task AddGroup()
    {
        await EditorInterop.AddGroupAsync(Guid.NewGuid().ToString(), "Yeni Grup", 100, 100, 400, 300, "#313244");
    }
    
    private async Task FitToScreen()
    {
        if (!_initialized) return;
        await EditorInterop.FitToScreenAsync();
    }
    
    private async Task ZoomIn()
    {
        _zoomLevel = Math.Min(_zoomLevel * 1.25, 3.0);
        await EditorInterop.SetZoomAsync(_zoomLevel);
    }
    
    private async Task ZoomOut()
    {
        _zoomLevel = Math.Max(_zoomLevel * 0.8, 0.3);
        await EditorInterop.SetZoomAsync(_zoomLevel);
    }
    
    private void HandleNodeSelected(string nodeId)
    {
        OnNodeSelected.InvokeAsync(nodeId);
    }

    private void HandleSelectionChanged(List<string> nodeIds)
    {
        _selectedNodeIds = nodeIds ?? new List<string>();
        OnSelectionChanged.InvokeAsync(nodeIds);
    }

    private void HandleSelectionCleared()
    {
        _selectedNodeIds.Clear();
        OnNodeSelected.InvokeAsync(null);
        OnSelectionChanged.InvokeAsync(new List<string>());
        OnSelectionCleared.InvokeAsync();
    }
    
    private void HandleNodeMoved(string nodeId, double x, double y)
    {
        // Node hareketi - isteğe bağlı tracking
    }
    
    private void HandleZoom(double zoom)
    {
        _zoomLevel = zoom;
        _contextMenu = (false, 0, 0);
        StateHasChanged();
    }

    private void HandleConnectionCreated(string fromNode, string fromPort, string toNode, string toPort)
    {
        OnConnectionCreated.InvokeAsync((fromNode, fromPort, toNode, toPort));
    }

    private void HandleContextMenu(string nodeId, double x, double y)
    {
        _contextMenuNodeId = nodeId;
        _contextMenu = (true, x, y);
        InvokeAsync(StateHasChanged);
    }

    [Parameter] public EventCallback OnCopyRequested { get; set; }
    [Parameter] public EventCallback OnPasteRequested { get; set; }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Check if inside input
        if (_renameDialogOpen) return;

        if (e.CtrlKey && e.Key.ToLower() == "c")
        {
            await OnCopyRequested.InvokeAsync();
        }
        else if (e.CtrlKey && e.Key.ToLower() == "v")
        {
            await OnPasteRequested.InvokeAsync();
        }
        else if (e.Key == "Delete")
        {
            await DeleteSelectedNode();
        }
    }

    private async Task RenameSelectedNode()
    {
        _contextMenu = (false, 0, 0);
        if (_contextMenuNodeId != null)
        {
            _renameInput = ""; // You could prefill if you track names locally
            _renameDialogOpen = true;
            StateHasChanged();
        }
    }

    private async Task ConfirmRename()
    {
        if (_contextMenuNodeId != null && !string.IsNullOrWhiteSpace(_renameInput))
        {
            await EditorInterop.UpdateNodeNameAsync(_contextMenuNodeId, _renameInput);
            await OnNodeRenamed.InvokeAsync(_contextMenuNodeId);
        }
        _renameDialogOpen = false;
    }

    private void CancelRename()
    {
        _renameDialogOpen = false;
    }

    private async Task HandleRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ConfirmRename();
        else if (e.Key == "Escape")
            CancelRename();
    }

    private async Task ToggleBypassSelectedNode()
    {
        _contextMenu = (false, 0, 0);
        if (_contextMenuNodeId != null)
        {
            // Basit toggle - client state tutmadığımız için şimdilik visual olarak sadece set ediyoruz
            // Gerçek state parent component'te tutulmalı
            await EditorInterop.SetNodeBypassAsync(_contextMenuNodeId, true);
            await OnNodeBypassToggled.InvokeAsync((_contextMenuNodeId, true));
        }
    }

    private async Task DuplicateSelectedNode()
    {
        _contextMenu = (false, 0, 0);
        // Duplicate logic for parent
    }

    private async Task DeleteSelectedNode()
    {
        _contextMenu = (false, 0, 0);
        
        // Multi-delete via keyboard
        if (_selectedNodeIds.Any())
        {
            foreach (var id in _selectedNodeIds.ToList())
            {
                await EditorInterop.RemoveNodeAsync(id);
                await OnNodeDeleted.InvokeAsync(id);
            }
            _selectedNodeIds.Clear();
        }
        else if (_contextMenuNodeId != null)
        {
            // Context menu single delete
            await EditorInterop.RemoveNodeAsync(_contextMenuNodeId);
            await OnNodeDeleted.InvokeAsync(_contextMenuNodeId);
        }
    }

    private async Task DisconnectSelectedNode()
    {
        _contextMenu = (false, 0, 0);
        // Disconnect logic (parent handles)
        if (_contextMenuNodeId != null)
        {
            // Just reusing OnNodeDeleted for now is incorrect, bypassing for placeholder
        }
    }
    
    private async Task OnRunClicked()
    {
        await OnRun.InvokeAsync();
    }
    
    private async Task OnStopClicked()
    {
        await OnStop.InvokeAsync();
    }
}
