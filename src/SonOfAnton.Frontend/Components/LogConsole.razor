@using SonOfAnton.Frontend.Services
@using SonOfAnton.Shared.DTOs
@using SonOfAnton.Shared.Enums
@using System.Text.Json
@using Microsoft.JSInterop
@inject LogStreamService LogStream
@implements IAsyncDisposable

<div class="log-console @(_isOpen ? "open" : "")">
    <div class="console-header" @onclick="ToggleConsole">
        <span class="icon">🖥️</span>
        <span class="title">Konsol</span>
        @if (_logs.Count > 0)
        {
            <span class="log-count">@_logs.Count</span>
        }
        <span class="toggle-icon">@(_isOpen ? "▾" : "▴")</span>
    </div>

    @if (_isOpen)
    {
        <div class="console-toolbar">
            <button class="toolbar-btn" @onclick="ClearLogs">🗑️ Temizle</button>
            <label class="auto-scroll">
                <input type="checkbox" @bind="_autoScroll" />
                Otomatik kaydır
            </label>
        </div>

        @if (_streamError is not null) { <p role="alert">@_streamError</p> }
        <div class="console-body" @ref="_logContainer">
            @if (_logs.Count == 0)
            {
                <div class="empty-state">
                    <span>Henüz log yok. Bir workflow çalıştırın.</span>
                </div>
            }
            else
            {
                @foreach (var log in _logs)
                {
                    <div class="log-entry @log.Level.ToString().ToLower()">
                        <span class="log-time">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                        <span class="log-level">@GetLevelIcon(log.Level)</span>
                        @if (!string.IsNullOrEmpty(log.NodeName))
                        {
                            <span class="log-node">[@log.NodeName]</span>
                        }
                        <span class="log-message">@log.Message</span>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid? ExecutionId { get; set; }

    private bool _isOpen = true;
    private bool _autoScroll = true;
    private List<LogEventDto> _logs = [];
    private ElementReference _logContainer;
    private Guid? _lastExecutionId;
    private CancellationTokenSource? _streamCancellation;
    private Task _streamTask = Task.CompletedTask;
    private string? _streamError;

    protected override async Task OnParametersSetAsync()
    {
        if (ExecutionId == _lastExecutionId) return;
        await StopStreamingAsync();
        _lastExecutionId = ExecutionId;
        _logs.Clear();
        _streamError = null;
        if (ExecutionId is { } id && id != Guid.Empty)
        {
            _streamCancellation = new CancellationTokenSource();
            _streamTask = ReadLogsAsync(id, _streamCancellation.Token);
        }
    }

    private async Task ReadLogsAsync(Guid executionId, CancellationToken cancellationToken)
    {
        try
        {
            await foreach (var log in LogStream.StreamLogsAsync(executionId, cancellationToken))
            {
                if (cancellationToken.IsCancellationRequested) break;
                _logs.Add(log);
                if (_logs.Count > 200) _logs.RemoveAt(0);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception)
        {
            _streamError = "Log bağlantısı kesildi. Execution ayrıntısından kayıtlı logları açabilirsiniz.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopStreamingAsync()
    {
        _streamCancellation?.Cancel();
        await _streamTask;
        _streamCancellation?.Dispose();
        _streamCancellation = null;
    }

    private void ToggleConsole()
    {
        _isOpen = !_isOpen;
    }

    private void ClearLogs()
    {
        _logs.Clear();
    }

    private string GetLevelIcon(LogLevel level) => level switch
    {
        LogLevel.Debug => "🔍",
        LogLevel.Info => "ℹ️",
        LogLevel.Warning => "⚠️",
        LogLevel.Error => "❌",
        _ => "📝"
    };

    public async ValueTask DisposeAsync() => await StopStreamingAsync();
}
