@using Blazor.Diagrams.Components
@using SonOfAnton.Frontend.Services
@using SonOfAnton.Shared.Models
@inject DiagramStateService DiagramState
@inject WorkflowApiService ApiService
@inject SseClientService SseClient
@inject ChatDiagramBridge ChatBridge
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="workflow-editor" @onkeydown="HandleGlobalKeyDown" tabindex="-1">
    <div class="toolbar">
        <div class="toolbar-left">
            <div class="brand-logo" style="margin-right: 1rem; display: flex; align-items: center;">
                <svg width="32" height="32" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M100 30L150 100H120L100 70L80 100H50L100 30Z" fill="var(--accent-color)" fill-opacity="0.2"/>
                  <path d="M100 30L130 170M100 30L70 170" stroke="var(--accent-color)" stroke-width="12" stroke-linecap="round"/>
                  <path d="M70 120H130" stroke="var(--accent-color)" stroke-width="12" stroke-linecap="round"/>
                  
                  <circle cx="100" cy="30" r="8" fill="var(--success-color)"/>
                  <circle cx="70" cy="120" r="6" fill="var(--accent-color)"/>
                  <circle cx="130" cy="120" r="6" fill="var(--accent-color)"/>
                  <circle cx="70" cy="170" r="6" fill="var(--accent-color)"/>
                  <circle cx="130" cy="170" r="6" fill="var(--accent-color)"/>
                </svg>
                <span class="brand-name" style="font-weight: 800; font-size: 14px; margin-left: 8px; color: var(--text-primary); letter-spacing: 1px;">SON OF ANTON</span>
            </div>
            <button class="btn btn-ghost" @onclick="() => _isFolderTreeOpen = !_isFolderTreeOpen" title="Klasörler">
                <Icon Name="folder" Size="14" />
            </button>
            <button class="btn btn-primary" @onclick="NewWorkflow">
                <Icon Name="plus" Size="14" /> Yeni
            </button>
            <button class="btn btn-secondary" @onclick="OpenTemplates">
                <Icon Name="layers" Size="14" /> Şablonlar
            </button>
            
            <span class="toolbar-divider" style="margin: 0 8px; border-left: 1px solid var(--border-color); height: 20px;"></span>

            <button class="btn btn-ghost" @onclick="() => DiagramState.Undo()" disabled="@(!DiagramState.CanUndo)" title="Geri Al (Ctrl+Z)">
                <Icon Name="corner-up-left" Size="14" />
            </button>
            <button class="btn btn-ghost" @onclick="() => DiagramState.Redo()" disabled="@(!DiagramState.CanRedo)" title="Yinele (Ctrl+Y)">
                <Icon Name="corner-up-right" Size="14" />
            </button>

            <span class="toolbar-divider" style="margin: 0 8px; border-left: 1px solid var(--border-color); height: 20px;"></span>

            <button class="btn btn-success" @onclick="SaveWorkflow" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span class="spinner-sm"></span>
                }
                else
                {
                    <Icon Name="save" Size="14" />
                }
                Kaydet
            </button>
            
            @if (_isAutoSaving)
            {
                <span class="autosave-indicator" style="font-size: 12px; color: var(--text-muted); margin-left: 8px;">Kaydediliyor...</span>
            }
            else if (_lastSaved.HasValue)
            {
                <span class="autosave-indicator" style="font-size: 12px; color: var(--text-muted); margin-left: 8px;">Kayıtlı: @_lastSaved.Value.ToString("HH:mm")</span>
            }
        </div>
        
        <div class="toolbar-center">
            <input type="text" 
                   class="workflow-name-input" 
                   @bind="@_workflowName" 
                   @bind:event="oninput"
                   placeholder="İş Akışı Adı" />
        </div>
        
        <div class="toolbar-right">
            <button class="btn btn-ghost" @onclick="() => _isSearchOpen = true" title="Ara (Ctrl+K)">
                <Icon Name="search" Size="14" />
            </button>
            <button class="btn btn-ghost" @onclick="ToggleTheme" title="@(_currentTheme == "dark" ? "Aydınlık Mod" : "Karanlık Mod")">
                <Icon Name="@(_currentTheme == "dark" ? "sun" : "moon")" Size="14" />
            </button>
            <button class="btn btn-ghost" @onclick="() => TogglePanel(nameof(_isChatOpen))" title="AI Asistan">
                <Icon Name="message-circle" Size="14" />
            </button>
            <button class="btn btn-ghost" @onclick="() => TogglePanel(nameof(_isYamlOpen))" title="YAML">
                <Icon Name="file-text" Size="14" />
            </button>
            <button class="btn btn-ghost" @onclick="() => TogglePanel(nameof(_isVariablesOpen))" title="Değişkenler">
                <Icon Name="variable" Size="14" />
            </button>
            <button class="btn btn-ghost" @onclick="() => TogglePanel(nameof(_isRevisionsOpen))" title="Revizyon Geçmişi">
                <Icon Name="history" Size="14" />
            </button>
            <span class="toolbar-divider"></span>
            @if (_isExecuting)
            {
                <button class="btn btn-warning" @onclick="PauseResumeExecution">
                    <Icon Name="@(_isPaused ? "play" : "pause")" Size="14" /> @(_isPaused ? "Devam" : "Duraklat")
                </button>
                <button class="btn btn-ghost" @onclick="() => _isSnapshotOpen = !_isSnapshotOpen" title="Snapshot'lar">
                    <Icon Name="camera" Size="14" />
                </button>
                <button class="btn btn-danger" @onclick="StopExecution">
                    <Icon Name="square" Size="14" /> Durdur
                </button>
            }
            else
            {
                <button class="btn btn-warning"
                        @onclick="ExecuteWorkflow"
                        disabled="@(DiagramState.CurrentWorkflow?.Id == Guid.Empty)">
                    <Icon Name="play" Size="14" /> Çalıştır
                </button>
            }
            <button class="btn btn-info" @onclick="ToggleMonitor">
                <Icon Name="activity" Size="14" /> Monitor
            </button>
            <a class="btn btn-ghost" href="/executions" title="Execution Geçmişi">
                <Icon Name="list" Size="14" />
            </a>
            <a class="btn btn-ghost" href="/dashboard" title="Dashboard">
                <Icon Name="bar-chart-2" Size="14" />
            </a>
        </div>
    </div>

    <div class="editor-container">
        @if (_isFolderTreeOpen)
        {
            <div class="folder-sidebar">
                <FolderTree OnFolderSelected="HandleFolderSelected" />
            </div>
        }

        <NodePalette OnNodeDrop="HandleNodeDrop" />
        
        <div class="canvas-container" 
             @ondragover="HandleDragOver" 
             @ondragover:preventDefault="true"
             @ondrop="HandleDrop"
             @ondrop:preventDefault="true">
            <CascadingValue Value="DiagramState.Diagram">
                <DiagramCanvas></DiagramCanvas>
            </CascadingValue>
            
            @if (_showConnectionHint)
            {
                <div class="connection-hint">
                    Bağlantı oluşturmak için bir çıkış portunu tutup bir giriş portuna sürükleyin
                </div>
            }
        </div>
        
        <NodePropertiesPanel />
    </div>

    <LogConsole ExecutionId="@_currentExecutionId" />
    
    <ExecutionMonitor @ref="_executionMonitor"
                      ExecutionId="@_currentExecutionId"
                      IsVisible="@_isMonitorVisible"
                      OnClose="HideMonitor"
                      OnNodeExecuting="HandleNodeExecuting"
                      OnNodeCompleted="HandleNodeCompleted" />
</div>

<TemplatesPanel IsOpen="_isTemplatesPanelOpen" 
                OnClose="CloseTemplates" 
                OnTemplateSelected="LoadTemplate" />

<GlobalSearch IsOpen="_isSearchOpen" OnClose="() => _isSearchOpen = false" />

<WorkflowChatPanel IsOpen="_isChatOpen" IsOpenChanged="v => { _isChatOpen = v; if (!v) StateHasChanged(); }"
                   WorkflowId="DiagramState.CurrentWorkflow?.Id" />

<YamlPreviewPanel IsOpen="_isYamlOpen" IsOpenChanged="v => { _isYamlOpen = v; if (!v) StateHasChanged(); }" />

<VariablesPanel IsOpen="_isVariablesOpen" IsOpenChanged="v => { _isVariablesOpen = v; if (!v) StateHasChanged(); }" />

<RevisionsPanel IsOpen="_isRevisionsOpen" IsOpenChanged="v => { _isRevisionsOpen = v; if (!v) StateHasChanged(); }" />

<SnapshotPanel IsOpen="_isSnapshotOpen" IsOpenChanged="v => _isSnapshotOpen = v"
               ExecutionId="_currentExecutionId ?? Guid.Empty" />

@if (DiagramState.CurrentWorkflow?.Id != null && DiagramState.CurrentWorkflow.Id != Guid.Empty)
{
    <div class="stats-floating">
        <WorkflowStatsCard WorkflowId="DiagramState.CurrentWorkflow.Id" />
    </div>
}

@code {
    private bool _isSaving;
    private bool _isExecuting;
    private Guid? _currentExecutionId;
    private bool _isTemplatesPanelOpen;
    private bool _isMonitorVisible;
    private bool _showConnectionHint = true;
    private string _workflowName = "Yeni İş Akışı";
    private ExecutionMonitor? _executionMonitor;

    // New panel states
    private bool _isSearchOpen;
    private bool _isChatOpen;
    private bool _isYamlOpen;
    private bool _isVariablesOpen;
    private bool _isRevisionsOpen;
    private bool _isSnapshotOpen;
    private bool _isPaused;
    private bool _isFolderTreeOpen;
    private string _currentTheme = "dark";
    
    private System.Timers.Timer? _autoSaveTimer;
    private bool _isAutoSaving;
    private DateTime? _lastSaved;

    private async Task ToggleTheme()
    {
        _currentTheme = await JS.InvokeAsync<string>("themeManager.toggleTheme");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _currentTheme = await JS.InvokeAsync<string>("themeManager.getTheme");
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private void TogglePanel(string panelName)
    {
        // Tıklanan panelin mevcut durumunu al
        var willOpen = panelName switch
        {
            nameof(_isChatOpen) => !_isChatOpen,
            nameof(_isYamlOpen) => !_isYamlOpen,
            nameof(_isVariablesOpen) => !_isVariablesOpen,
            nameof(_isRevisionsOpen) => !_isRevisionsOpen,
            _ => false
        };

        // Tüm panelleri kapat
        _isChatOpen = false;
        _isYamlOpen = false;
        _isVariablesOpen = false;
        _isRevisionsOpen = false;

        // Sadece tıklanan paneli aç (eğer kapalıysa)
        if (willOpen)
        {
            switch (panelName)
            {
                case nameof(_isChatOpen): _isChatOpen = true; break;
                case nameof(_isYamlOpen): _isYamlOpen = true; break;
                case nameof(_isVariablesOpen): _isVariablesOpen = true; break;
                case nameof(_isRevisionsOpen): _isRevisionsOpen = true; break;
            }
        }
    }

    protected override void OnInitialized()
    {
        DiagramState.OnStateChanged += HandleStateChanged;
        DiagramState.CreateNewWorkflow();
        
        // Timer
        _autoSaveTimer = new System.Timers.Timer(3000);
        _autoSaveTimer.Elapsed += async (sender, e) => await HandleAutoSaveTimerAsync();
        _autoSaveTimer.AutoReset = false;
        
        // İlk workflow adını ayarla
        _workflowName = DiagramState.CurrentWorkflow?.Name ?? "Yeni İş Akışı";
    }
    
    private void HandleStateChanged()
    {
        // Workflow değiştiğinde adı güncelle
        if (DiagramState.CurrentWorkflow != null && 
            DiagramState.CurrentWorkflow.Name != _workflowName)
        {
            _workflowName = DiagramState.CurrentWorkflow.Name;
        }
        
        // Autosave Timer reset
        _autoSaveTimer?.Stop();
        _autoSaveTimer?.Start();
        
        StateHasChanged();
    }

    private async Task HandleAutoSaveTimerAsync()
    {
        _isAutoSaving = true;
        await InvokeAsync(StateHasChanged);
        
        await SaveWorkflow();
        
        _isAutoSaving = false;
        await InvokeAsync(StateHasChanged);
    }

    private void NewWorkflow()
    {
        DiagramState.CreateNewWorkflow();
        _workflowName = "Yeni İş Akışı";
        _currentExecutionId = null;
        _isExecuting = false;
    }

    private void HandleFolderSelected(Guid? folderId)
    {
        Console.WriteLine($"Folder selected: {folderId}");
    }

    private void HandleGlobalKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "k")
        {
            _isSearchOpen = !_isSearchOpen;
            StateHasChanged();
        }
        else if (e.CtrlKey && e.Key == "z")
        {
            DiagramState.Undo();
        }
        else if (e.CtrlKey && (e.Key == "y" || (e.ShiftKey && e.Key == "Z")))
        {
            DiagramState.Redo();
        }
    }

    private async Task SaveWorkflow()
    {
        if (_isSaving) return;
        _isSaving = true;

        try
        {
            // Workflow adını güncelle
            if (DiagramState.CurrentWorkflow != null)
            {
                DiagramState.CurrentWorkflow.Name = _workflowName;
            }
            
            var request = new SonOfAnton.Shared.DTOs.SaveWorkflowRequest
            {
                Id = DiagramState.CurrentWorkflow?.Id != Guid.Empty ? DiagramState.CurrentWorkflow?.Id : null,
                Name = _workflowName,
                Description = DiagramState.CurrentWorkflow?.Description,
                TriggerType = DiagramState.CurrentWorkflow?.TriggerType ?? SonOfAnton.Shared.Enums.TriggerType.Manual,
                IsActive = DiagramState.CurrentWorkflow?.IsActive ?? false,
                Graph = DiagramState.GetCurrentGraph()
            };

            var saved = await ApiService.SaveWorkflowAsync(request);
            if (saved != null)
            {
                // Grafikte radikal değişikleri önlemek için yeniden load etmeyiz eğer aynı graph ise.
                if (DiagramState.CurrentWorkflow?.Id != saved.Id) 
                {
                    DiagramState.LoadWorkflow(saved);
                }
                _workflowName = saved.Name;
                _lastSaved = DateTime.Now;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kaydetme hatası: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ExecuteWorkflow()
    {
        if (_isExecuting || DiagramState.CurrentWorkflow?.Id == null || DiagramState.CurrentWorkflow.Id == Guid.Empty)
            return;

        _isExecuting = true;
        _isMonitorVisible = true;

        try
        {
            var execution = await ApiService.ExecuteWorkflowAsync(DiagramState.CurrentWorkflow.Id);
            if (execution != null)
            {
                _currentExecutionId = execution.Id;
                
                // ExecutionMonitor'a bağlan
                if (_executionMonitor != null)
                {
                    await _executionMonitor.ConnectAsync();
                }
                
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Çalıştırma hatası: {ex.Message}");
            _isExecuting = false;
        }
    }
    
    private async Task StopExecution()
    {
        if (_currentExecutionId.HasValue)
        {
            try
            {
                await ApiService.CancelExecutionAsync(_currentExecutionId.Value);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Durdurma hatası: {ex.Message}");
            }
        }
        
        _isExecuting = false;
        
        if (_executionMonitor != null)
        {
            await _executionMonitor.DisconnectAsync();
        }
    }
    
    private void ToggleMonitor()
    {
        _isMonitorVisible = !_isMonitorVisible;
    }
    
    private void HideMonitor()
    {
        _isMonitorVisible = false;
    }
    
    private void HandleNodeExecuting(Guid nodeId)
    {
        // Node'u executing stiline çevir
        DiagramState.SetNodeExecuting(nodeId, true);
    }
    
    private void HandleNodeCompleted((Guid NodeId, bool Success) args)
    {
        // Node'u completed stiline çevir
        DiagramState.SetNodeExecuting(args.NodeId, false);
        DiagramState.SetNodeCompleted(args.NodeId, args.Success);
        
        // Tüm node'lar tamamlandıysa execution'ı bitir
        // Bu basit bir kontrol, gerçek uygulamada SSE event'i ile yapılır
    }

    private void HandleNodeDrop((SonOfAnton.Shared.Models.NodeDefinition Node, double X, double Y) args)
    {
        _showConnectionHint = false;
        var definition = new SonOfAnton.Shared.DTOs.NodeDefinitionDto
        {
            Type = args.Node.Type,
            Name = args.Node.Name,
            Icon = args.Node.Icon,
            Category = args.Node.Category,
            Color = args.Node.Color
        };
        DiagramState.AddNode(definition, args.X, args.Y);
    }

    private void HandleDragOver(DragEventArgs e)
    {
        // Drop'a izin ver
    }

    private void HandleDrop(DragEventArgs e)
    {
        _showConnectionHint = false;
        var draggedNode = NodePalette.DraggedNode;
        if (draggedNode != null)
        {
            var x = e.ClientX - 300;
            var y = e.ClientY - 120;
            
            var definition = new SonOfAnton.Shared.DTOs.NodeDefinitionDto
            {
                Type = draggedNode.Type,
                Name = draggedNode.Name,
                Icon = draggedNode.Icon,
                Category = draggedNode.Category,
                Color = draggedNode.Color
            };
            DiagramState.AddNode(definition, x, y);
            NodePalette.ClearDraggedNode();
        }
    }

    private async Task AddNodeAsync(string nodeType, double x, double y)
    {
        var definition = await ApiService.GetNodeDefinitionAsync(nodeType);
        if (definition != null)
        {
            DiagramState.AddNode(definition, x, y);
        }
    }

    private void OpenTemplates()
    {
        _isTemplatesPanelOpen = true;
    }

    private void CloseTemplates()
    {
        _isTemplatesPanelOpen = false;
    }

    private void LoadTemplate(WorkflowTemplate template)
    {
        DiagramState.LoadFromTemplate(template);
        _workflowName = template.Name;
        _isTemplatesPanelOpen = false;
    }

    private async Task PauseResumeExecution()
    {
        if (!_currentExecutionId.HasValue) return;

        try
        {
            if (_isPaused)
            {
                await ApiService.ResumeExecutionAsync(_currentExecutionId.Value);
                _isPaused = false;
            }
            else
            {
                await ApiService.PauseExecutionAsync(_currentExecutionId.Value);
                _isPaused = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Pause/Resume hatası: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        DiagramState.OnStateChanged -= HandleStateChanged;
        
        if (_autoSaveTimer != null)
        {
            _autoSaveTimer.Stop();
            _autoSaveTimer.Dispose();
        }

        if (_executionMonitor != null)
        {
            await _executionMonitor.DisposeAsync();
        }
    }
}
