@using SonOfAnton.Shared.Models

<div class="templates-panel @(IsOpen ? "open" : "")">
    <div class="templates-header">
        <h3><Icon Name="layers" Size="18" /> �ablonlar</h3>
        <button class="close-btn" @onclick="Close">
            <Icon Name="x" Size="18" />
        </button>
    </div>
    
    <div class="templates-content">
        <p class="templates-description">
            Haz�r �ablonlardan birini se�erek h�zl�ca ba�lay�n
        </p>
        
        @foreach (var category in TemplatesByCategory)
        {
            <div class="template-category">
                <h4 class="category-title">@category.Key</h4>
                <div class="template-list">
                    @foreach (var template in category.Value)
                    {
                        <div class="template-card" 
                             style="--template-color: @template.Color"
                             @onclick="() => SelectTemplate(template)">
                            <div class="template-icon">
                                <Icon Name="@template.Icon" Size="24" Color="@template.Color" />
                            </div>
                            <div class="template-info">
                                <span class="template-name">@template.Name</span>
                                <span class="template-desc">@template.Description</span>
                            </div>
                            <div class="template-arrow">
                                <Icon Name="chevron-right" Size="16" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (IsOpen)
{
    <div class="templates-overlay" @onclick="Close"></div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<WorkflowTemplate> OnTemplateSelected { get; set; }

    private Dictionary<string, List<WorkflowTemplate>> TemplatesByCategory =>
        WorkflowTemplates.GetTemplatesByCategory();

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task SelectTemplate(WorkflowTemplate template)
    {
        await OnTemplateSelected.InvokeAsync(template);
        await Close();
    }
}

